<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/review_logo_iv"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/review_main_logo"
        android:layout_marginBottom="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/horizontal_line1" />

    <View
        android:id="@+id/horizontal_line1"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginBottom="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/review_title_tv"/>

    <TextView
        android:id="@+id/review_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="쩝쩝리뷰"
        android:textColor="@color/mainColor"
        android:textSize="48sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/horizontal_line2"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/review_title_tv"/>

    <TextView
        android:id="@+id/review_detail_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="모든 리뷰를 한 번에!"
        android:textColor="@color/mainColor"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/horizontal_line2"/>

</androidx.constraintlayout.widget.ConstraintLayout>